# fritz-netwatch configuration
# Copy this file to ".env" and fill in your values. ".env" is git-ignored.

# Your FRITZ!Box (gateway) and repeater
ROUTER_IP="192.168.178.1"
INTERNET_IP="1.1.1.1"
REPEATER_IP="192.168.178.26"

# The repeater password is stored in the macOS Keychain, NOT here.
# Create it once with:
#   security add-generic-password -a "netwatch-repeater" -s "netwatch-repeater" -w 'YOUR_PASSWORD' -U
KEYCHAIN_ITEM="netwatch-repeater"

# ntfy topic for phone push (leave empty to only use macOS notifications)
NTFY_TOPIC=""

# Detection thresholds
LOSS_MAX=30      # % packet loss to the router -> storm
RTT_MAX=800      # ms max round-trip to the router -> storm
COOLDOWN=3600    # seconds between two automatic reboots

# Optional: FRITZ!Box login for DOCSIS line monitoring (cable models only).
# Store the box password:
#   security add-generic-password -a "netmon-box" -s "netmon-box" -w 'YOUR_BOX_PW' -U
BOX_IP="192.168.178.1"
BOX_KEYCHAIN="netmon-box"

# Safety: the checker only runs when the default gateway is your home router.
# Optional extra check - the gateway's MAC address (find it with: arp -n 192.168.178.1)
HOME_ROUTER_MAC=""
